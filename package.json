{
  "name": "teamsheet11",
  "version": "0.1.0",
  "private": true,
  "description": "Free match day graphics for grassroots football clubs.",
  "license": "AGPL-3.0-only",
  "homepage": "https://teamsheet11.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kroqdotdev/ts11.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:graphics": "node scripts/check-graphics.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "2.1.10",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.22",
    "better-sqlite3": "^13.1.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "modern-screenshot": "4.7.0",
    "motion": "14.7.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "2.0.8",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "1.56.1",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
