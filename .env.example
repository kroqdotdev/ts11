# Copy to .env.production on the server (or .env.local for development) and fill in.
# Development needs only the first two; mail then goes to data/dev/outbox and images
# to data/dev/objects.

# Public origin and a long random secret (openssl rand -hex 32).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google sign-in: an OAuth web client with redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amazon SES (API v2). Give the IAM user a send-only policy for your domain identity.
AWS_REGION=eu-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
MAIL_FROM="teamsheet11 <noreply@example.com>"

# Image storage and database backup: any S3-compatible bucket (path-style URLs).
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_PATH=litestream/teamsheet11

# Optional limits (defaults shown).
# LIMIT_IMAGE_BYTES=2097152
# LIMIT_IMAGE_SIDE=2560
# LIMIT_ACCOUNT_BYTES=262144000
# LIMIT_CLUBS=50
# LIMIT_UPLOADS_PER_HOUR=60
